{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Rangel Luxo Crochê",
  "short_name": "Rangel Crochê",
  "description": "Atelier Rangel Luxo - Peças artesanais exclusivas em crochê de alto padrão, sousplats com plaqueta dourada e trilhos de mesa sob medida.",
  "id": "/?source=pwa",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait-primary",
  "background_color": "#FAF8F5",
  "theme_color": "#8C533E",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": [
    "shopping",
    "lifestyle",
    "home-decor"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "assets/icons/icon-72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
