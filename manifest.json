  "shortcuts": [
    {
      "name": "Coleção Nobre",
      "short_name": "Coleção",
      "description": "Ver peças de crochê exclusivas e sousplats",
      "url": "/#colecao",
      "icons": [
        {
          "src": "assets/icons/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Fazer Encomenda",
      "short_name": "Encomenda",
      "description": "Solicitar orçamento e encomenda personalizada",
      "url": "/#encomenda",
      "icons": [
        {
          "src": "assets/icons/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Depoimentos Reais",
